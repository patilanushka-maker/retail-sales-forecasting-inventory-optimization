# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.env
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env.*
!.env.example

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Temporary logs & scratch files
*.log
scratch/
.system_generated/

# Streamlit local runtime state
.streamlit/secrets.toml

# Large Raw and Interim Datasets (Download instructions provided in documentation)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Large serialized models (exceeding recommended GitHub version control size)
models/*.joblib
!models/.gitkeep

# Retain lightweight processed datasets and outputs for out-of-the-box demonstration
!data/processed/.gitkeep
!data/processed/*.parquet
!outputs/**

# Documentation and image assets
!images/**
